<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_it_asset_loan_form" model="ir.ui.view">
        <field name="name">it.asset.loan.form</field>
        <field name="model">it.asset.loan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_return" type="object" string="Marquer comme retourné"
                            class="btn-primary" invisible="state == 'returned'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="equipment_id" domain="[('asset_status', '=', 'available')]"/>
                            <field name="employee_id"/>
                        </group>
                        <group>
                            <field name="date_loan"/>
                            <field name="date_return_expected"/>
                            <field name="date_return_actual" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_it_asset_loan_search" model="ir.ui.view">
        <field name="name">it.asset.loan.search</field>
        <field name="model">it.asset.loan</field>
        <field name="arch" type="xml">
            <search>
                <field name="equipment_id"/>
                <field name="employee_id"/>
                <filter string="En cours" name="filter_ongoing" domain="[('state', '=', 'ongoing')]"/>
                <filter string="Retournés" name="filter_returned" domain="[('state', '=', 'returned')]"/>
            </search>
        </field>
    </record>

    <record id="view_it_asset_loan_list" model="ir.ui.view">
        <field name="name">it.asset.loan.list</field>
        <field name="model">it.asset.loan</field>
        <field name="arch" type="xml">
            <list>
                <field name="equipment_id"/>
                <field name="employee_id"/>
                <field name="date_loan"/>
                <field name="date_return_expected"/>
                <field name="date_return_actual"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'ongoing'"
                       decoration-success="state == 'returned'"/>
            </list>
        </field>
    </record>

    <record id="action_it_asset_loan" model="ir.actions.act_window">
        <field name="name">Prêts d'équipements</field>
        <field name="res_model">it.asset.loan</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_it_asset_loan"
              name="Prêts"
              parent="maintenance.menu_maintenance_title"
              action="action_it_asset_loan"
              groups="maintenance.group_equipment_manager,base.group_user"
              sequence="3"/>

</odoo>